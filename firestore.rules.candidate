rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['super_admin','superadmin','سوپر_مدیر','سوپر مدیر','سوپرمدیر','سوپر_ادمین','سوپر ادمین','سوپرادمین','مدیر_کل','مدیر کل','مدیرکل'];
    }
    function isManagerOf(vendorId) {
      return signedIn()
        && exists(/databases/$(database)/documents/vendors/$(vendorId))
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.managerUid == request.auth.uid;
    }
    function isOwnerOf(vendorId) {
      return signedIn()
        && exists(/databases/$(database)/documents/vendors/$(vendorId))
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid == request.auth.uid;
    }
    function isStoreManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['store_manager','مدیر_فروشگاه','مدیر فروشگاه','آرایشگر','ارایشگر'];
    }
    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','email','role','storeId','createdAt','updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'customer';
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','updatedAt']);
      allow delete: if false;
    }
    match /vendors/{vendorId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.status == 'approved')
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && resource.data.managerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id','name','phone','mobile','address','detail','rubika','services','hours',
          'weeklyHours','weeklySchedule','schedule','bookingIntervalMinutes','lat','lng','faq',
          'ownerUid','managerUid','status','managerApplication','createdAt','updatedAt'
        ])
        && request.resource.data.id == vendorId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('managerApplication' in request.resource.data) || request.resource.data.managerApplication is bool)
        && (request.resource.data.managerUid == null
          || (request.resource.data.managerUid == request.auth.uid && isStoreManager()));
      allow update: if resource.data.status != 'archived'
        && (isOwnerOf(vendorId) || isManagerOf(vendorId) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','phone','mobile','address','detail','rubika','services','hours',
          'weeklyHours','weeklySchedule','schedule','bookingIntervalMinutes','lat','lng','faq','updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid)
        || (signedIn() && isManagerOf(resource.data.vendorId))
        || (signedIn() && isOwnerOf(resource.data.vendorId));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id','customerUid','vendorId','vendorName','vendorPhone','vendorRubika',
          'name','phone','service','date','time','note','status','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id','customerUid','vendorId','name','phone','service','date','time','status','createdAt','updatedAt'
        ])
        && request.resource.data.id == bookingId
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'در انتظار تأیید'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.service is string
        && request.resource.data.vendorId is string
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId))
        && get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.status == 'approved';
      allow update, delete: if false;
    }
    match /bookingLocks/{lockId} {
      allow read, write: if false;
    }
  }
}